# Optional: override the built-in Wrapper remote URL.
VITE_WRAPPER_REMOTE_URL=https://irserver2.eku.edu/libraries/remote/r19-wrapper.cjs

# Optional: set to true to append a random ?v=<id> query value to the Wrapper
# URL on each page load. This bypasses browser caching and is intended for
# testing a changing remote build. The default behavior is false.
VITE_WRAPPER_APPEND_RANDOM_ID=true
